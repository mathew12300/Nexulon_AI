# Environment Configuration Template
# Copy to .env and fill in your values

# ============================================
# DEBUG & SECURITY
# ============================================
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*.nexulon.ai

# ============================================
# DATABASE
# ============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nexulon_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ============================================
# REDIS & CACHE
# ============================================
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1

# ============================================
# CELERY (TASK QUEUE)
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================
# JWT TOKENS
# ============================================
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=900  # 15 minutes
JWT_REFRESH_TOKEN_LIFETIME=604800  # 7 days

# ============================================
# CORS
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@nexulon.ai

# ============================================
# EXTERNAL SERVICES
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key
ELASTICSEARCH_HOST=localhost:9200

# ============================================
# AWS S3 (File Storage)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_STORAGE_BUCKET_NAME=nexulon-uploads
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=your-domain.s3.amazonaws.com

# ============================================
# STRIPE PAYMENTS (Optional)
# ============================================
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# SENTRY ERROR TRACKING (Optional)
# ============================================
SENTRY_DSN=https://key@sentry.io/project

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_JOB_MATCHING=True
FEATURE_RESUME_OPT=True
FEATURE_INTERVIEW=True
FEATURE_AUTO_APPLY=False

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=Nexulon AI
